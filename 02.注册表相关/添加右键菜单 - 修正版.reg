@="cmd.exe /s /k right_menu_zip_dirs_with_python_libs.bat \"%V\""

;--------子菜单 ssj_dir_zip_to_kbf_file ------------------------------------
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\CommandStore\shell\ssj_dir_zip_to_kbf_file]
"Icon"="C:\\Windows\\System32\\cmd.exe"
@="随手记-打包文件夹为KBF文件"

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\CommandStore\shell\ssj_dir_zip_to_kbf_file\command]
@="cmd.exe /s /k right_menu_ssj_zip_dirs_to_kbf_file.bat \"%V\""


